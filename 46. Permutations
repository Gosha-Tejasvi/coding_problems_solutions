import itertools
class Solution:
    def permute(self, nums: List[int]) -> List[List[int]]:
        return list(itertools.permutations(nums))

--------------------------------------
Actual Long method without using  itertools library
--------------------------------------
class Solution:
    def permute(self, nums):
        res = []
        
        def perm(i):
            if i == len(nums):
                res.append(nums[:])
                return
            for j in range(i, len(nums)):
                nums[i], nums[j] = nums[j], nums[i]
                perm(i + 1)
                nums[i], nums[j] = nums[j], nums[i]
        
        perm(0)
        return res

        

        
